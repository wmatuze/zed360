# Public web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Backend API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
# Number of reverse proxies (load balancer, CDN) in front of the API. Public
# rate limits key on the client IP, so set this in production or every visitor
# shares the proxy's address. Leave at 0 when the API is reached directly.
TRUST_PROXY_HOPS=0

# Managed PostgreSQL/PostGIS
# Use the session-pooler URL for the running API when a direct IPv6 connection
# is not available. Keep `sslmode=require` on hosted connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Use a direct connection when available; otherwise use the session pooler.
# Drizzle uses this URL only for schema migrations.
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Redis is not required until background matching and notifications are enabled.
REDIS_URL=redis://localhost:6379

# Object storage — configure when media uploads are enabled
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=zed360-local
BUSINESS_MEDIA_BUCKET=business-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Review verification. Keyed hash for reviewer phone numbers: generate a
# random value of at least 32 characters and never change it once reviews
# exist, or repeat-review checks will stop recognising earlier numbers.
CONTACT_HASH_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters

# Communication — configure when notifications are enabled
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
# WhatsApp Cloud API. Review codes use an approved "authentication" template
# with a copy-code button. Without these outside production, codes are
# written to the API log instead.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v23.0
